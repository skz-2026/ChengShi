<Window x:Class="Chengshi.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="欢迎使用澄时"
        Height="600"
        Width="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="0"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Margin="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== 左侧品牌 + 步骤 ===== -->
      <Border Grid.Column="0" Background="{StaticResource SideBrush}">
        <Grid Margin="30,34,30,30">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <Canvas Width="34" Height="34" Margin="0,0,0,16">
              <Path Data="M 17,2 L 29,11 L 25,14 L 22,12.5 L 22,26 L 12,26 L 12,12.5 L 9,14 L 5,11 Z"
                    Fill="{StaticResource AccentOnBrush}" Opacity="0.92"/>
            </Canvas>
            <TextBlock Text="澄时"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SideActiveBrush}"/>
            <TextBlock Text="给孩子清爽、可控的屏幕时间"
                       Foreground="{StaticResource SideMutedBrush}"
                       FontSize="12"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22" x:Name="StepDot1">
              <Ellipse Width="10" Height="10" Fill="{StaticResource AccentOnBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="欢迎" Margin="12,0,0,0" FontSize="14" Foreground="{StaticResource SideActiveBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22" x:Name="StepDot2">
              <Ellipse Width="10" Height="10" Fill="{StaticResource SideLineBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="设家长密码" Margin="12,0,0,0" FontSize="14" Foreground="{StaticResource SideMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22" x:Name="StepDot3">
              <Ellipse Width="10" Height="10" Fill="{StaticResource SideLineBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="选书桌和时长" Margin="12,0,0,0" FontSize="14" Foreground="{StaticResource SideMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" x:Name="StepDot4">
              <Ellipse Width="10" Height="10" Fill="{StaticResource SideLineBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="完成" Margin="12,0,0,0" FontSize="14" Foreground="{StaticResource SideMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Row="2"
                     Text="全程都在本机完成，不会上传任何数据。"
                     Foreground="{StaticResource SideMutedBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <!-- ===== 右侧步骤内容 ===== -->
      <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="38,34,38,10">
          <!-- 步骤 1：欢迎 -->
          <StackPanel x:Name="Step1" Visibility="Visible" VerticalAlignment="Center">
            <Canvas Width="92" Height="92" HorizontalAlignment="Left" Margin="0,0,0,18">
              <Ellipse Width="92" Height="92" Fill="{StaticResource AccentSoftBrush}"/>
              <Path Data="M 46,20 C 33,20 23,30 23,43 C 23,56 33,66 46,66 C 59,66 69,56 69,43 C 69,30 59,20 46,20 Z M 43,30 L 49,30 L 49,46 L 60,52 L 57,57 L 46,50 Z"
                    Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Canvas>
            <TextBlock Text="欢迎使用澄时"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="几分钟就能给孩子设好一道清爽的屏幕护栏。"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="14"
                       Margin="0,8,0,24"
                       TextWrapping="Wrap"/>
            <StackPanel Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                  <Path Data="M 9,15 L 13,19 L 21,10" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="限定能开哪些软件，孩子只能玩你允许的" FontSize="14" Foreground="{StaticResource InkBrush}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                  <Path Data="M 9,15 L 13,19 L 21,10" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="每天时间到了自动锁屏，不吵架不抢电脑" FontSize="14" Foreground="{StaticResource InkBrush}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                  <Path Data="M 9,15 L 13,19 L 21,10" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="绿色上网，拦掉短视频、游戏和成人内容" FontSize="14" Foreground="{StaticResource InkBrush}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- 步骤 2：家长密码 -->
          <StackPanel x:Name="Step2" Visibility="Collapsed">
            <TextBlock Text="设一个家长密码"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock Text="改设置、加时间、退出澄时都要它。孩子不知道，也没法改。"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"
                       Margin="0,8,0,22"
                       TextWrapping="Wrap"/>
            <TextBlock Text="家长密码" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PinCreateBox" Style="{StaticResource FieldPassword}" InputMethod.IsInputMethodEnabled="False" Margin="0,0,0,14"/>
            <TextBlock Text="再输一次" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PinConfirmBox" Style="{StaticResource FieldPassword}" InputMethod.IsInputMethodEnabled="False"/>
            <TextBlock x:Name="PinError" Foreground="{StaticResource WarnBrush}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 12,2 L 22,20 L 2,20 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,10,0"/>
                <TextBlock Text="设好后我们会生成一组「找回码」，万一忘了密码可以找回。找回码会在最后一步显示，记得抄下来。"
                           Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 步骤 3：书桌 + 时长 -->
          <StackPanel x:Name="Step3" Visibility="Collapsed">
            <TextBlock Text="选一个书桌，定每天时长"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock Text="书桌决定孩子能用哪些软件；时长决定每天能用多久。"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"
                       Margin="0,8,0,18"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="ReconfigNote"
                       Text="重新设置：这次只调整书桌和周内基础时长。周末时长、按星期的单独设置、密码和找回码都不会被改动。"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,14"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock Text="使用场景" Style="{StaticResource SectionLabel}"/>
            <ListBox x:Name="OnboardDeskList"
                     Height="150"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource DeskItem}"
                     SelectionChanged="OnboardDeskList_SelectionChanged">
              <ListBox.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
              </ListBox.Resources>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
            <Grid Margin="0,22,0,0">
              <TextBlock Text="每天屏幕时间" Style="{StaticResource SectionLabel}" Margin="0"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton x:Name="OnboardDur30" Content="30 分" Tag="30" GroupName="OnboardDuration"
                             Style="{StaticResource DurationPill}" Margin="0,0,8,0" Checked="OnboardDuration_Checked"/>
                <RadioButton x:Name="OnboardDur60" Content="1 小时" Tag="60" GroupName="OnboardDuration"
                             Style="{StaticResource DurationPill}" Margin="0,0,8,0" IsChecked="True" Checked="OnboardDuration_Checked"/>
                <RadioButton x:Name="OnboardDur90" Content="90 分" Tag="90" GroupName="OnboardDuration"
                             Style="{StaticResource DurationPill}" Margin="0,0,8,0" Checked="OnboardDuration_Checked"/>
                <RadioButton x:Name="OnboardDurCustom" Content="自定义" Tag="custom" GroupName="OnboardDuration"
                             Style="{StaticResource DurationPill}" Checked="OnboardDuration_Checked"/>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="OnboardCustomPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
              <TextBox x:Name="OnboardCustomBox" Style="{StaticResource SearchBox}" Width="90" InputMethod.IsInputMethodEnabled="False"/>
              <TextBlock Text="分钟 / 天（5–600）" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="拿不准怎么设？一键套用推荐：" Style="{StaticResource FieldLabel}" Margin="0,16,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Button Content="小学生 · 写作业 1 小时" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Tag="homework|60" Click="ApplyPreset_Click"/>
              <Button Content="初中生 · 网课 1.5 小时" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Tag="class|90" Click="ApplyPreset_Click"/>
              <Button Content="高中生 · 编程 2 小时" Style="{StaticResource OutlineButton}" Tag="code|120" Click="ApplyPreset_Click"/>
            </StackPanel>
            <TextBlock Text="书桌里的软件之后都能在「守护设置」里随意增减。"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
          </StackPanel>

          <!-- 步骤 4：完成 -->
          <StackPanel x:Name="Step4" Visibility="Collapsed">
            <Canvas Width="72" Height="72" Margin="0,0,0,16">
              <Ellipse Width="72" Height="72" Fill="{StaticResource AccentSoftBrush}"/>
              <Path Data="M 24,37 L 33,46 L 50,27" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Canvas>
            <TextBlock Text="都准备好了"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="26"
                       FontWeight="SemiBold"/>
            <TextBlock Text="下面是你刚设好的守护，确认无误就可以开始。"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"
                       Margin="0,8,0,20"
                       TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,16">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <TextBlock Text="书桌" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock x:Name="SummaryDesk" Text="—" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <TextBlock x:Name="SummaryMinutesLabel" Text="每天时长" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock x:Name="SummaryMinutes" Text="—" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                  <TextBlock Text="家长密码" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="已设置" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                </Grid>
              </StackPanel>
            </Border>
            <StackPanel x:Name="RecoveryPanel">
              <TextBlock Text="找回码（请抄下来，忘记密码时用）" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                  <TextBlock x:Name="RecoveryCodeText" FontFamily="{StaticResource MonoFont}" FontSize="18" Text="————"/>
                </Border>
                <Button Grid.Column="1" Content="复制" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" VerticalAlignment="Stretch" Click="CopyRecovery_Click"/>
              </Grid>
            </StackPanel>
            <TextBlock x:Name="ReconfigPinNote"
                       Text="家长密码与找回码保持不变；要改密码或换邮箱找回，请到主界面的「守护设置」。"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="重要：请给孩子使用「标准用户」账号" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="如果孩子用的是管理员账号（或者知道管理员密码），孩子可以通过卸载守护服务、改系统设置绕开澄时。给孩子建标准账号后再开始守护，守护才靠得住。"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="FinishError" Foreground="{StaticResource WarnBrush}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <!-- ===== 底部导航 ===== -->
        <Grid Grid.Row="1" Margin="38,0,38,26">
          <TextBlock x:Name="StepIndicator" Text="第 1 / 4 步" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SkipButton" Content="保存设置，暂不守护" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Skip_Click" Visibility="Collapsed"
                    ToolTip="保存刚才设的密码、书桌、时长和找回码，但不马上开始守护；之后在主界面点「开始守护」即可。"/>
            <Button x:Name="BackButton" Content="上一步" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Back_Click"/>
            <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}" MinWidth="104" Click="Next_Click"/>
            <Button x:Name="FinishButton" Content="开始守护" Style="{StaticResource PrimaryButton}" MinWidth="116" Click="Finish_Click" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
